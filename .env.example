# AgriShield AI Environment Configuration (.env.example)

# System & App Environment
ENVIRONMENT=development
DEBUG=True
PORT=8000
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Security & Authentication
SECRET_KEY=replace-with-a-secure-random-secret-key-minimum-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
# Default to SQLite for local lightweight development, PostgreSQL for production
DATABASE_URL=sqlite:///./services/api/agrishield.db
# DATABASE_URL=postgresql://agrishield:password@localhost:5432/agrishield_ai

# Storage & Upload Paths
UPLOAD_DIR=./services/api/uploads
MODEL_DIR=./ml/artifacts/deployed

# ML Inference Configuration
MODEL_VERSION=1.0.0
ACTIVE_BACKBONE=mobilenet_v3_large
CONFIDENCE_THRESHOLD=0.82
UNCERTAINTY_THRESHOLD=0.45
OOD_ENERGY_THRESHOLD=-7.5
BLUR_LAPLACIAN_THRESHOLD=100.0
MIN_LUMINANCE=40.0
MAX_LUMINANCE=220.0
